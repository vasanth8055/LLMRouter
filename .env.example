APP_NAME=LLMRouter
ROUTER_MODE=v5-platt
LLM_PROVIDER_MODE=mock
DEEPSEEK_API_KEY=
DEEPSEEK_API_MODEL=
GEMINI_API_KEY=
GEMINI_FLASH_API_MODEL="gemini-3.8-flash"
GEMINI_PRO_API_MODEL=
# Optional JSON object keyed by actual provider API model ID. Rates are USD per million tokens.
LIVE_MODEL_PRICING={}
LLM_REQUEST_TIMEOUT_S=60
DEEPSEEK_EXPECTED_LATENCY_MS=
GEMINI_FLASH_EXPECTED_LATENCY_MS=
GEMINI_PRO_EXPECTED_LATENCY_MS=
SMALL_MODEL_NAME=mock-small
MEDIUM_MODEL_NAME=mock-medium
LARGE_MODEL_NAME=mock-large
OPENAI_API_KEY=
AWS_REGION=
# Local PostgreSQL connection. Replace angle-bracket placeholders locally.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:<port>/<database>
FRONTEND_ORIGIN=http://127.0.0.1:5173

# docker compose up -d uses these process environment values.
POSTGRES_DB=llmrouter
POSTGRES_USER=llmrouter
POSTGRES_PASSWORD=<set-a-local-password>
POSTGRES_HOST_PORT=5432
